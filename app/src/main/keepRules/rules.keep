# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep all app classes, models, UI composables, and logic from being stripped or obfuscated
-keep class com.example.phonics_ta_in.** { *; }
-keepclassmembers class com.example.phonics_ta_in.** { *; }
